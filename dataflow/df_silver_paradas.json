{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(CodigoPublicado = iif(isNull(CodigoPublicado) || length(trim(CodigoPublicado)) == 0, ParadaHistoricaId, CodigoPublicado),",
				"          Estado = upper(trim(Estado)),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = initCap(trim(Zona)),",
				"          VigenciaDesde = toDate(VigenciaDesde, 'yyyy-MM-dd'),",
				"          VigenciaHasta = toDate(VigenciaHasta, 'yyyy-MM-dd'),",
				"          Latitud = toDecimal(Latitud, 10, 6),",
				"          Longitud = toDecimal(Longitud, 10, 6)) ~> derivedColumn1"
			]
		}
	}
}