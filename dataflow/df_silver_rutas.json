{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!isNull(RutaHistoricaId) &&",
				"!isNull(CodigoRuta) &&",
				"!isNull(NombreRuta) &&",
				"!isNull(Origen) &&",
				"!isNull(Destino) &&",
				"!isNull(VigenciaDesde) &&",
				"!isNull(VigenciaHasta) &&",
				"!isNull(Estado) &&",
				"length(trim(toString(RutaHistoricaId))) > 0 &&",
				"length(trim(toString(CodigoRuta))) > 0 &&",
				"length(trim(toString(NombreRuta))) > 0 &&",
				"length(trim(toString(Origen))) > 0 &&",
				"length(trim(toString(Destino))) > 0 &&",
				"length(trim(toString(VigenciaDesde))) > 0 &&",
				"length(trim(toString(VigenciaHasta))) > 0 &&",
				"length(trim(toString(Estado))) > 0) ~> filter1",
				"filter1 derive(RutaHistoricaId = upper(trim(toString(RutaHistoricaId))),",
				"          Estado = upper(trim(toString(Estado)))) ~> derivedColumn1",
				"derivedColumn1 derive(CodigoRuta = iif(     startsWith(upper(trim(toString(CodigoRuta))), 'R-'),     upper(trim(toString(CodigoRuta))),     iif(         startsWith(upper(trim(toString(CodigoRuta))), 'RUTA '),         concat(             'R-',             lpad(trim(substring(upper(trim(toString(CodigoRuta))), 6)), 2, '0')         ),         concat(             'R-',             lpad(trim(toString(CodigoRuta)), 2, '0')         )     ) ),",
				"          NombreRuta = regexReplace(trim(toString(NombreRuta)), ' +', ' '),",
				"          Origen = regexReplace(trim(toString(Origen)), ' +', ' '),",
				"          Destino = regexReplace(trim(toString(Destino)), ' +', ' ')) ~> derivedColumn2",
				"derivedColumn2 derive(VigenciaDesde = iif(\r",
				"    regexMatch(trim(toString(VigenciaDesde)), `^\\d{5}$`),\r",
				"    addDays(\r",
				"        toDate('1899-12-30'),\r",
				"        toInteger(trim(toString(VigenciaDesde)))\r",
				"    ),\r",
				"    iif(\r",
				"        regexMatch(trim(toString(VigenciaDesde)), `^\\d{2}/\\d{2}/\\d{4}$`),\r",
				"        toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),\r",
				"        toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd')\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    regexMatch(trim(toString(VigenciaHasta)), `^\\d{5}$`),\r",
				"    addDays(\r",
				"        toDate('1899-12-30'),\r",
				"        toInteger(trim(toString(VigenciaHasta)))\r",
				"    ),\r",
				"    iif(\r",
				"        regexMatch(trim(toString(VigenciaHasta)), `^\\d{2}/\\d{2}/\\d{4}$`),\r",
				"        toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'),\r",
				"        toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd')\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(RutaHistoricaId) &&",
				"!isNull(CodigoRuta) &&",
				"!isNull(NombreRuta) &&",
				"!isNull(Origen) &&",
				"!isNull(Destino) &&",
				"!isNull(VigenciaDesde) &&",
				"!isNull(VigenciaHasta) &&",
				"!isNull(Estado) &&",
				"length(trim(toString(RutaHistoricaId))) > 0 &&",
				"length(trim(toString(RutaHistoricaId))) <= 30 &&",
				"length(trim(toString(CodigoRuta))) > 0 &&",
				"length(trim(toString(CodigoRuta))) <= 20 &&",
				"length(trim(toString(NombreRuta))) > 0 &&",
				"length(trim(toString(NombreRuta))) <= 120 &&",
				"length(trim(toString(Origen))) > 0 &&",
				"length(trim(toString(Origen))) <= 80 &&",
				"length(trim(toString(Destino))) > 0 &&",
				"length(trim(toString(Destino))) <= 80 &&",
				"length(trim(toString(Estado))) > 0 &&",
				"length(trim(toString(Estado))) <= 20 &&",
				"VigenciaDesde <= VigenciaHasta) ~> filter2",
				"filter2 aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}