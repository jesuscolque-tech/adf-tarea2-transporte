{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "auxiliar",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter3"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!isNull(ViajeId) &&",
				"!isNull(RutaHistoricaId) &&",
				"!isNull(VehiculoId) &&",
				"!isNull(FechaServicio) &&",
				"!isNull(HoraProgramada) &&",
				"!isNull(HoraSalida) &&",
				"!isNull(HoraLlegada) &&",
				"!isNull(ValidacionesTarjeta) &&",
				"!isNull(KmRecorridos) &&",
				"!isNull(EstadoViaje) &&",
				"length(trim(toString(ViajeId))) > 0 &&",
				"length(trim(toString(RutaHistoricaId))) > 0 &&",
				"length(trim(toString(VehiculoId))) > 0 &&",
				"length(trim(toString(FechaServicio))) > 0 &&",
				"length(trim(toString(HoraProgramada))) > 0 &&",
				"length(trim(toString(HoraSalida))) > 0 &&",
				"length(trim(toString(HoraLlegada))) > 0 &&",
				"length(trim(toString(ValidacionesTarjeta))) > 0 &&",
				"length(trim(toString(KmRecorridos))) > 0 &&",
				"length(trim(toString(EstadoViaje))) > 0) ~> filter1",
				"filter1 derive(ViajeId = upper(trim(toString(ViajeId))),",
				"          RutaHistoricaId = upper(trim(toString(RutaHistoricaId))),",
				"          VehiculoId = upper(trim(toString(VehiculoId))),",
				"          ValidacionesTarjeta = toInteger(trim(toString(ValidacionesTarjeta))),",
				"          KmRecorridos = toDecimal(trim(toString(KmRecorridos)), 8, 1),",
				"          EstadoViaje = upper(trim(toString(EstadoViaje)))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(     regexMatch(trim(toString(FechaServicio)), `^\\d{5}$`),     addDays(         toDate('1899-12-30'),         toInteger(trim(toString(FechaServicio)))     ),     iif(         regexMatch(trim(toString(FechaServicio)), `^\\d{2}/\\d{2}/\\d{4}$`),         toDate(trim(toString(FechaServicio)), 'dd/MM/yyyy'),         toDate(trim(toString(FechaServicio)), 'yyyy-MM-dd')     ) )) ~> derivedColumn2",
				"derivedColumn2 derive(HoraProgramada = regexReplace(trim(toString(HoraProgramada)), `^.*?(\\d{2}:\\d{2}).*$`, '$1'),",
				"          HoraSalida = regexReplace(trim(toString(HoraSalida)), `^.*?(\\d{2}:\\d{2}).*$`, '$1'),",
				"          HoraLlegada = regexReplace(trim(toString(HoraLlegada)), `^.*?(\\d{2}:\\d{2}).*$`, '$1')) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(ViajeId) &&",
				"!isNull(RutaHistoricaId) &&",
				"!isNull(VehiculoId) &&",
				"!isNull(FechaServicio) &&",
				"!isNull(HoraProgramada) &&",
				"!isNull(HoraSalida) &&",
				"!isNull(HoraLlegada) &&",
				"!isNull(ValidacionesTarjeta) &&",
				"!isNull(KmRecorridos) &&",
				"!isNull(EstadoViaje) &&",
				"",
				"length(trim(toString(ViajeId))) > 0 &&",
				"length(ViajeId) <= 30 &&",
				"",
				"length(trim(toString(RutaHistoricaId))) > 0 &&",
				"length(RutaHistoricaId) <= 30 &&",
				"",
				"length(trim(toString(VehiculoId))) > 0 &&",
				"length(VehiculoId) <= 20 &&",
				"",
				"length(trim(toString(EstadoViaje))) > 0 &&",
				"length(EstadoViaje) <= 20 &&",
				"",
				"regexMatch(toString(HoraProgramada), `^([01][0-9]|2[0-3]):[0-5][0-9]$`) &&",
				"regexMatch(toString(HoraSalida), `^([01][0-9]|2[0-3]):[0-5][0-9]$`) &&",
				"regexMatch(toString(HoraLlegada), `^([01][0-9]|2[0-3]):[0-5][0-9]$`) &&",
				"",
				"ValidacionesTarjeta >= 0 &&",
				"KmRecorridos >= 0 &&",
				"KmRecorridos <= 9999999.9) ~> filter2",
				"filter2 aggregate(groupBy(ViajeId),",
				"     CantidadRegistros = count()) ~> aggregate1",
				"aggregate1 filter(CantidadRegistros == 1) ~> filter3",
				"filter2, filter3 join(derivedColumn1@ViajeId == aggregate1@ViajeId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ViajeId = derivedColumn1@ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(HoraProgramada = concat(HoraProgramada, ':00'),",
				"          HoraSalida = concat(HoraSalida, ':00'),",
				"          HoraLlegada = concat(HoraLlegada, ':00')) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}