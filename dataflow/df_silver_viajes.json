{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "auxiliar",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter2"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "filter3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(",
				"!isNull(ViajeId) &&",
				"!isNull(RutaHistoricaId) &&",
				"!isNull(VehiculoId) &&",
				"!isNull(FechaServicio) &&",
				"!isNull(HoraProgramada) &&",
				"!isNull(HoraSalida) &&",
				"!isNull(HoraLlegada) &&",
				"!isNull(ValidacionesTarjeta) &&",
				"!isNull(KmRecorridos) &&",
				"!isNull(EstadoViaje)",
				") ~> filter1",
				"filter1 derive(ViajeId = trim(toString(ViajeId)),",
				"          RutaHistoricaId = trim(toString(RutaHistoricaId)),",
				"          VehiculoId = trim(toString(VehiculoId)),",
				"          EstadoViaje = upper(trim(toString(EstadoViaje))),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          KmRecorridos =  toDecimal(     replace(trim(KmRecorridos), ',', '.'),     8,     1 )) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = \r",
				"iif(\r",
				"    instr(trim(FechaServicio), '/') > 0,\r",
				"    toDate(trim(FechaServicio), 'dd/MM/yyyy'),\r",
				"    toDate(trim(FechaServicio), 'yyyy-MM-dd')\r",
				")\r",
				") ~> derivedColumn2",
				"derivedColumn2 derive(HoraProgramada =  iif(     length(trim(HoraProgramada)) == 5,     trim(HoraProgramada),     iif(         length(trim(HoraProgramada)) == 8,         substring(trim(HoraProgramada), 1, 5),         substring(trim(HoraProgramada), 12, 5)     ) ),",
				"          HoraSalida = \r",
				"iif(\r",
				"    length(trim(HoraSalida)) == 5,\r",
				"    trim(HoraSalida),\r",
				"    iif(\r",
				"        length(trim(HoraSalida)) == 8,\r",
				"        substring(trim(HoraSalida), 1, 5),\r",
				"        substring(trim(HoraSalida), 12, 5)\r",
				"    )\r",
				")\r",
				",",
				"          HoraLlegada = \r",
				"iif(\r",
				"    length(trim(HoraLlegada)) == 5,\r",
				"    trim(HoraLlegada),\r",
				"    iif(\r",
				"        length(trim(HoraLlegada)) == 8,\r",
				"        substring(trim(HoraLlegada), 1, 5),\r",
				"        substring(trim(HoraLlegada), 12, 5)\r",
				"    )\r",
				")\r",
				") ~> derivedColumn3",
				"derivedColumn3 filter(",
				"!isNull(ViajeId) &&",
				"!isNull(RutaHistoricaId) &&",
				"!isNull(VehiculoId) &&",
				"!isNull(FechaServicio) &&",
				"!isNull(HoraProgramada) &&",
				"!isNull(HoraSalida) &&",
				"!isNull(HoraLlegada) &&",
				"!isNull(ValidacionesTarjeta) &&",
				"!isNull(KmRecorridos) &&",
				"!isNull(EstadoViaje)",
				") ~> filter2",
				"filter2 derive(ViajeId =  iif(     startsWith(upper(trim(ViajeId)), 'VJ-'),     upper(trim(ViajeId)),     concat(         'VJ-',         toString(year(FechaServicio)),         '-',         lpad(trim(ViajeId), 5, '0')     ) ),",
				"          RutaHistoricaId =  iif(     startsWith(upper(trim(RutaHistoricaId)), 'RH-'),     upper(trim(RutaHistoricaId)),     iif(         startsWith(upper(trim(RutaHistoricaId)), 'R-'),         concat('RH-', substring(upper(trim(RutaHistoricaId)), 3)),         iif(             startsWith(upper(trim(RutaHistoricaId)), 'RUTA '),             concat('RH-', lpad(trim(substring(RutaHistoricaId, 6)), 2, '0')),             iif(                 startsWith(upper(trim(RutaHistoricaId)), 'R'),                 concat('RH-', substring(upper(trim(RutaHistoricaId)), 2)),                 concat('RH-', lpad(trim(RutaHistoricaId), 2, '0'))             )         )     ) ),",
				"          VehiculoId =  iif(     startsWith(upper(trim(VehiculoId)), 'V-'),     upper(trim(VehiculoId)),     concat('V-', lpad(trim(VehiculoId), 3, '0')) )) ~> derivedColumn4",
				"derivedColumn4 filter(",
				"",
				"regexMatch(ViajeId, '^VJ-[0-9]{4}-[0-9]{5}$') &&",
				"regexMatch(RutaHistoricaId, '^RH-[0-9]{2}(-[A-Z]+)?$') &&",
				"regexMatch(VehiculoId, '^V-[0-9]{3}$')",
				") ~> filter3",
				"filter3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}